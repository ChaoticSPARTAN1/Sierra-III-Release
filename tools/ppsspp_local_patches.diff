+	if (!addr || !Memory::IsValidAddress(addr))
+		return;
+	const u32 thread = Memory::ReadUnchecked_U32(addr);
+	if (thread == 0 || thread != (u32)__KernelGetCurThread())
+		return;
+	const u32 ra = currentMIPS->r[MIPS_REG_RA];
+	if (seen.size() < 500 && seen.insert(std::make_pair(info, ra)).second)
+		fprintf(stderr, "MESTRICT: %s from %08x\n", info->name ? info->name : "?", ra);
+}
