+// local patch (Halo PSP port, b106): PSP_PCSAMPLE=<file> samples the PC (and
+// $ra) of the running thread every PSP_PCSAMPLE_CYCLES emulated cycles
+// (default 33300: 100 us at 333 MHz) and writes "thread pc ra count" lines to
+// the file every 4096 samples. Emulated cycles, so it finds where the game's
+// instructions go (no cache model): tools/pcprofile.py maps it to functions
+#include <map>
+#include <tuple>
+static int pcSampleEvent = -1;
+static s64 pcSampleCycles = 33300;
+static std::map<std::tuple<std::string, u32, u32, std::string>, u64> pcSamples;
+// PSP_PCSAMPLE_STEP=<hex address> (b106): a pointer variable in the game
+// (its psp_step's last_step: the name of the step running), read at each
+// sample and written as a fifth field, so a step's samples (every thread's)
+// can be told apart: tools/pcprofile.py --step
+static u32 pcSampleStepAddress = 0;
+static u64 pcSampleCount = 0;
+static void PcSampleDump() {
+	const char *path = getenv("PSP_PCSAMPLE");
+	if (!path) return;
+	FILE *f = fopen(path, "w");
+	if (!f) return;
+	for (auto &e : pcSamples)
+		if (pcSampleStepAddress)
+			fprintf(f, "%s %08x %08x %llu %s\n", std::get<0>(e.first).c_str(), std::get<1>(e.first), std::get<2>(e.first), (unsigned long long)e.second, std::get<3>(e.first).c_str());
+		else
+			fprintf(f, "%s %08x %08x %llu\n", std::get<0>(e.first).c_str(), std::get<1>(e.first), std::get<2>(e.first), (unsigned long long)e.second);
+	fclose(f);
+}
+static void PcSampleCallback(u64 userdata, int cyclesLate) {
+	const char *name = __KernelGetThreadName(__KernelGetCurThread());
+	std::string thread = name ? name : "?";
+	for (auto &c : thread) if (c == ' ') c = '_';
+	std::string step = "-";
+	if (pcSampleStepAddress && Memory::IsValid4AlignedAddress(pcSampleStepAddress)) {
+		u32 pointer = Memory::ReadUnchecked_U32(pcSampleStepAddress);
+		if (pointer && Memory::IsValidAddress(pointer)) {
+			const char *text = Memory::GetCharPointerUnchecked(pointer);
+			size_t length = 0;
+			while (length < 64 && Memory::IsValidAddress(pointer + (u32)length) && text[length])
+				length++;
+			step.assign(text, length);
+			for (auto &c : step) if (c == ' ' || c == '\n' || c == '\t') c = '_';
+			if (step.empty()) step = "-";
+		}
+	}
+	pcSamples[std::make_tuple(thread, currentMIPS->pc, currentMIPS->r[31], step)]++;
+	if (++pcSampleCount % 4096 == 0)
+		PcSampleDump();
+	ScheduleEvent(pcSampleCycles - cyclesLate, pcSampleEvent, 0);
+}
+
 void Advance(MIPSState *mips) {
 	PROFILE_THIS_SCOPE("advance");
+	if (pcSampleEvent < 0 && getenv("PSP_PCSAMPLE")) {
+		const char *c = getenv("PSP_PCSAMPLE_CYCLES");
+		if (c && atoll(c) > 1000) pcSampleCycles = atoll(c);
+		const char *s = getenv("PSP_PCSAMPLE_STEP");
+		if (s) pcSampleStepAddress = (u32)strtoul(s, nullptr, 16);
+		pcSampleEvent = RegisterEvent("PcSample", PcSampleCallback);
+		ScheduleEvent(pcSampleCycles, pcSampleEvent, 0);
+	}
 	int cyclesExecuted = slicelength - mips->downcount;
 	globalTimer += cyclesExecuted;
 	mips->downcount = slicelength;
