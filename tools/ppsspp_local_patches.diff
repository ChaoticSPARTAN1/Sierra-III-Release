+}
+static void CoverageRecord(u32 start, u32 count) {
+	static const char *path = getenv("PSP_COVERAGE");
+	static bool registered = false;
+	if (!path)
+		return;
+	if (!registered) {
+		registered = true;
+		atexit(CoverageWrite);
+	}
+	if (!coverageBlocks.insert(std::make_pair(start, count)).second)
+		return;
+	if (coverageBlocks.size() - coverageWritten >= 1024)
+		CoverageWrite();
+}
