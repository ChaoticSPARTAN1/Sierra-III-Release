+// local patch (Halo PSP port, 2026-10-09): an Allegrex D-cache model on the
+// interpreter's loads and stores (16 KB, 2-way, 64-byte lines, LRU, write
+// allocate), PSP_DCACHE=1. Decodes each load/store before it executes (the
+// base register is current then), so memory touched inside HLE calls and
+// function replacements is not seen. Uncached addresses (bit 30, the
+// 0x4xxxxxxx mirrors) and the scratchpad bypass the cache and are counted
+// apart. PSP_DCACHE_PHASE=<hex address> of the game's phase word (0 other,
+// 1 tick, 2 drawing, 3 frame end) splits every count by phase. At exit:
+// PSP_DCACHE_OUT (default /tmp/claude-0/dcache.bin): a header, then per
+// 64-byte line of 0x08000000-0x0A000000, per phase, accesses and misses.
+namespace {
+struct DCacheState {
+	bool on = false, init = false;
+	u32 tag[128][2];
+	u8 lru[128];
+	u32 phase_addr = 0;
+	static const u32 lo = 0x08000000, hi = 0x0A000000;
+	static const int PHASES = 4;
+	std::vector<u32> accesses, misses;  // [phase][line]
+	ICacheModel icache;                  // its own I-cache model, for misses by phase
+	std::vector<u32> ifetches, imisses;  // [phase][line]
+	std::vector<u32> dmiss_pc;           // [phase][line of the instruction whose access missed]
+	u64 ifetched[PHASES] = {}, imissed[PHASES] = {};
+	// ticks: the phase word's entries into the tick phase (1), which the game
+	// sets around each game_tick; printed at exit, so a run's counts can be
+	// read per tick exactly (a run from a savestate starts mid-window)
+	u64 ticks = 0;
+	int last_phase = 0;
+	u64 total[PHASES] = {}, missed[PHASES] = {}, uncached[PHASES] = {}, scratch[PHASES] = {}, stores[PHASES] = {};
+	void setup() {
+		init = true;
+		on = getenv("PSP_DCACHE") != nullptr;
+		if (!on) return;
+		for (int s = 0; s < 128; s++) { tag[s][0] = tag[s][1] = 0xFFFFFFFF; lru[s] = 0; }
+		if (const char *a = getenv("PSP_DCACHE_PHASE")) phase_addr = (u32)strtoul(a, nullptr, 16);
+		accesses.assign((size_t)PHASES * ((hi - lo) >> 6), 0);
+		misses.assign((size_t)PHASES * ((hi - lo) >> 6), 0);
+		ifetches.assign((size_t)PHASES * ((hi - lo) >> 6), 0);
+		imisses.assign((size_t)PHASES * ((hi - lo) >> 6), 0);
+		dmiss_pc.assign((size_t)PHASES * ((hi - lo) >> 6), 0);
+	}
+	void dump() {
+		if (!on) return;
+		const char *out = getenv("PSP_DCACHE_OUT");
+		FILE *f = fopen(out ? out : "/tmp/claude-0/dcache.bin", "wb");
+		if (!f) return;
+		u64 header[2 + 7 * PHASES] = { 0x44434D33ULL /* "DCM3" */, (u64)PHASES };
+		for (int i = 0; i < PHASES; i++) {
+			header[2 + i] = total[i]; header[2 + PHASES + i] = missed[i]; header[2 + 2 * PHASES + i] = uncached[i];
+			header[2 + 3 * PHASES + i] = scratch[i]; header[2 + 4 * PHASES + i] = stores[i];
+			header[2 + 5 * PHASES + i] = ifetched[i]; header[2 + 6 * PHASES + i] = imissed[i];
+		}
+		fwrite(header, sizeof(header), 1, f);
+		fwrite(accesses.data(), 4, accesses.size(), f);
+		fwrite(misses.data(), 4, misses.size(), f);
+		fwrite(ifetches.data(), 4, ifetches.size(), f);
+		fwrite(imisses.data(), 4, imisses.size(), f);
+		fwrite(dmiss_pc.data(), 4, dmiss_pc.size(), f);
+		fclose(f);
+		u64 t = 0, m = 0;
+		for (int i = 0; i < PHASES; i++) { t += total[i]; m += missed[i]; }
+		fprintf(stderr, "DCACHE: %llu cached accesses, %llu misses (%.3f%%); %llu ticks\n", (unsigned long long)t,
+			(unsigned long long)m, t ? 100.0 * m / t : 0.0, (unsigned long long)ticks);
+	}
+	inline int current_phase() {
+		int phase = 0;
+		if (phase_addr) {
+			phase = (int)Memory::ReadUnchecked_U32(phase_addr);
+			if (phase < 0 || phase >= PHASES) phase = 0;
+		}
+		return phase;
+	}
+	inline void fetch(u32 pc) {
+		int phase = current_phase();
+		if (phase == 1 && last_phase != 1) ticks++;
+		last_phase = phase;
+		u32 p = pc & 0x1FFFFFFF;
+		bool hit = icache.access(p);
+		ifetched[phase]++;
+		if (!hit) imissed[phase]++;
+		if (p >= lo && p < hi) {
+			size_t i = (size_t)phase * ((hi - lo) >> 6) + ((p - lo) >> 6);
+			ifetches[i]++;
+			if (!hit) imisses[i]++;
+		}
+	}
+	inline void access(u32 addr, bool store, MIPSState *mips) {
+		int phase = current_phase();
+		if (store) stores[phase]++;
+		if ((addr & 0x1FFFC000) == 0x00010000) { scratch[phase]++; return; }
+		if (addr & 0x40000000) { uncached[phase]++; return; }
+		u32 p = addr & 0x1FFFFFFF;
+		u32 line = p >> 6, set = line & 127;
+		total[phase]++;
+		bool hit = true;
+		if (tag[set][0] == line) lru[set] = 1;
+		else if (tag[set][1] == line) lru[set] = 0;
+		else {
+			int victim = lru[set];
+			tag[set][victim] = line;
+			lru[set] = victim ^ 1;
+			missed[phase]++;
+			hit = false;
+			u32 pc = mips->pc & 0x1FFFFFFF;
+			if (pc >= lo && pc < hi)
+				dmiss_pc[(size_t)phase * ((hi - lo) >> 6) + ((pc - lo) >> 6)]++;
+		}
+		if (p >= lo && p < hi) {
+			size_t i = (size_t)phase * ((hi - lo) >> 6) + ((p - lo) >> 6);
+			accesses[i]++;
+			if (!hit) misses[i]++;
+		}
+	}
+};
+DCacheState g_dcache;
+struct DCacheDumper { ~DCacheDumper() { g_dcache.dump(); } } g_dcache_dumper;
+}
+void PSPDCacheDump() { g_dcache.dump(); g_dcache.on = false; }
+static inline void DCacheOp(MIPSOpcode op, MIPSState *mips) {
+	if (!g_dcache.init) g_dcache.setup();
+	if (!g_dcache.on) return;
+	g_dcache.fetch(mips->pc);
+	u32 code = op.encoding;
+	u32 opcode = code >> 26;
+	bool store;
+	s32 offset;
+	switch (opcode) {
+	case 0x20: case 0x21: case 0x22: case 0x23: case 0x24: case 0x25: case 0x26: case 0x30: case 0x31:
+		store = false; offset = (s16)(code & 0xFFFF); break;
+	case 0x28: case 0x29: case 0x2A: case 0x2B: case 0x2E: case 0x38: case 0x39:
+		store = true; offset = (s16)(code & 0xFFFF); break;
+	case 0x32: case 0x35: case 0x36:  // lv.s, lvl/lvr.q, lv.q
+		store = false; offset = (s16)(code & 0xFFFC); break;
+	case 0x3A: case 0x3D: case 0x3E:  // sv.s, svl/svr.q, sv.q
+		store = true; offset = (s16)(code & 0xFFFC); break;
+	default:
+		return;
+	}
+	u32 rs = (code >> 21) & 31;
+	g_dcache.access(mips->r[rs] + offset, store, mips);
+}
