+
+// local patch (Halo PSP port, build 102): an Allegrex I-cache model on the
+// interpreter's fetches (16 KB, 2-way, 64-byte lines, LRU), PSP_ICACHE=1.
+// With PSP_ICACHE_MAP=<file> of "old_start old_end new_start" lines (hex),
+// a second cache sees the same fetches at a remapped address: the miss count
+// of a reordered program, measured on one run. At exit, counts go to
+// PSP_ICACHE_OUT (default /tmp/claude-0/icache.bin): per 64-byte line of the
+// game's text (0x08804000-0x08C00000) its fetches and its misses.
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#include <algorithm>
+#include <string>
+namespace {
+struct ICacheModel {
+	u32 tag[128][2];
+	u8 lru[128];
+	u64 misses = 0;
+	ICacheModel() { for (int s = 0; s < 128; s++) { tag[s][0] = tag[s][1] = 0xFFFFFFFF; lru[s] = 0; } }
+	inline bool access(u32 addr) {
+		u32 line = addr >> 6, set = line & 127;
+		if (tag[set][0] == line) { lru[set] = 1; return true; }
+		if (tag[set][1] == line) { lru[set] = 0; return true; }
+		int victim = lru[set];  // lru[set] names the way to replace next
+		tag[set][victim] = line;
+		lru[set] = victim ^ 1;
+		misses++;
+		return false;
+	}
+};
+struct ICacheMap {
+	std::vector<u32> old_start, old_end, new_start;
+	ICacheModel cache;
+	inline u32 mapped(u32 pc) const {
+		size_t i = std::upper_bound(old_start.begin(), old_start.end(), pc) - old_start.begin();
+		if (i == 0) return pc;
+		i--;
+		if (pc < old_end[i]) return new_start[i] + (pc - old_start[i]);
+		return pc;
+	}
+};
+struct ICacheState {
+	bool on = false, init = false;
+	ICacheModel a;
+	std::vector<ICacheMap> maps;
+	u64 fetches = 0;
+	std::vector<u32> line_fetches, line_misses, line_misses_b;
+	static const u32 lo = 0x08804000, hi = 0x08C00000;
+	void setup() {
+		init = true;
+		on = getenv("PSP_ICACHE") != nullptr;
+		if (!on) return;
+		line_fetches.assign((hi - lo) >> 6, 0);
+		line_misses.assign((hi - lo) >> 6, 0);
+		line_misses_b.assign((hi - lo) >> 6, 0);
+		// PSP_ICACHE_MAP: one or more map files, comma-separated
+		if (const char *m = getenv("PSP_ICACHE_MAP")) {
+			std::string all(m);
+			size_t at = 0;
+			while (at <= all.size()) {
+				size_t comma = all.find(',', at);
+				std::string name = all.substr(at, comma == std::string::npos ? std::string::npos : comma - at);
+				if (!name.empty()) {
+					FILE *f = fopen(name.c_str(), "r");
+					ICacheMap map;
+					unsigned a1, a2, a3;
+					while (f && fscanf(f, "%x %x %x", &a1, &a2, &a3) == 3) {
+						map.old_start.push_back(a1); map.old_end.push_back(a2); map.new_start.push_back(a3);
+					}
+					if (f) fclose(f);
+					if (!map.old_start.empty()) maps.push_back(map);
+				}
+				if (comma == std::string::npos) break;
+				at = comma + 1;
+			}
+		}
+	}
+	void dump() {
+		if (!on) return;
+		const char *out = getenv("PSP_ICACHE_OUT");
+		FILE *f = fopen(out ? out : "/tmp/claude-0/icache.bin", "wb");
+		if (!f) return;
+		u64 header[4] = { fetches, a.misses, maps.empty() ? 0ULL : maps[0].cache.misses, (u64)maps.size() };
+		fwrite(header, sizeof(header), 1, f);
+		fwrite(line_fetches.data(), 4, line_fetches.size(), f);
+		fwrite(line_misses.data(), 4, line_misses.size(), f);
+		fwrite(line_misses_b.data(), 4, line_misses_b.size(), f);
+		fclose(f);
+		fprintf(stderr, "ICACHE: %llu fetches, %llu misses (%.3f%%)", (unsigned long long)fetches,
+			(unsigned long long)a.misses, fetches ? 100.0 * a.misses / fetches : 0.0);
+		for (size_t i = 0; i < maps.size(); i++)
+			fprintf(stderr, "; layout %d: %llu misses (%+.1f%%)", (int)i + 1, (unsigned long long)maps[i].cache.misses,
+				a.misses ? 100.0 * ((double)maps[i].cache.misses - (double)a.misses) / (double)a.misses : 0.0);
+		fprintf(stderr, "\n");
+	}
+	inline void fetch(u32 pc) {
+		u32 p = pc & 0x1FFFFFFF;
+		fetches++;
+		bool hit = a.access(p);
+		bool in_text = p >= lo && p < hi;
+		if (in_text) {
+			line_fetches[(p - lo) >> 6]++;
+			if (!hit) line_misses[(p - lo) >> 6]++;
+		}
