+// local patch (Halo PSP port, 2026-10-10): PSP_MESTRICT=<hex address> names a
+// word in the game's memory that holds a thread's id while that thread runs
+// code meant for the Media Engine on the main CPU (simulated: this emulator
+// runs no ME code), and 0 otherwise. A system call that thread makes then is
+// one the ME couldn't make: each distinct function and caller is printed once,
+// "MESTRICT: <function> from <return address>". Other threads are unaffected.
+static void MeStrictCheck(const HLEFunction *info) {
+	static bool init = false;
+	static u32 addr = 0;
