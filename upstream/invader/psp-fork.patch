+                else {
+                    workload.psp_animation_bytes_before += before;
+                    workload.psp_animation_bytes_after += before;
+                }
+            }
         }
     }
 }
diff --git a/src/tag/parser/compile/model_collision_geometry.cpp b/src/tag/parser/compile/model_collision_geometry.cpp
index 1e8a7994..6e02db2f 100644
--- a/src/tag/parser/compile/model_collision_geometry.cpp
+++ b/src/tag/parser/compile/model_collision_geometry.cpp
@@ -191,3 +191,33 @@ namespace Invader::Parser {
         }
     }
 }
+
+namespace Invader::Parser {
+    // PSP port: a collision BSP's edges, surfaces and bsp2d references at
+    // 16 bits (invader-build -G). Every campaign BSP's counts fit: edges to
+    // 57,375 (unsigned), vertices and surfaces to 28,751, planes to 19,123 and
+    // bsp2d nodes to 28,445 with the flag bit kept at bit 15; no index is
+    // ever NONE in those tables. bsp3d nodes (to 51,300, with a leaf flag)
+    // and the rest stay as they are. The game's structs match under HALO_PSP.
+    //   edge:            6 x u16 (was 6 x u32)
+    //   surface:         i16 plane (flag 0x8000), u16 first edge, u8 flags, i8 breakable, i16 material (was 12 bytes)
+    //   bsp2d reference: i16 plane (flag), i16 bsp2d node (flag) (was 8 bytes)
+    void ModelCollisionGeometryBSP::post_compile(BuildWorkload &workload, std::size_t, std::size_t struct_index, std::size_t offset) {
+        if(!workload.get_build_parameters()->psp_external_geometry.has_value()) {
+            return;
+        }
+        // Packing waits until every build-time reader of the collision BSP
+        // (the scenario's encounter placement among them) is done: the
+        // workload packs these just before the tag data is laid out
+        auto &s = workload.structs[struct_index];
+        auto &bsp = *reinterpret_cast<struct_little *>(s.data.data() + offset);
+        BuildWorkload::PSPCollisionBlocks blocks = {};
+        blocks.edges = bsp.edges.count ? s.resolve_pointer(&bsp.edges.pointer) : std::nullopt;
+        blocks.surfaces = bsp.surfaces.count ? s.resolve_pointer(&bsp.surfaces.pointer) : std::nullopt;
+        blocks.references = bsp.bsp2d_references.count ? s.resolve_pointer(&bsp.bsp2d_references.pointer) : std::nullopt;
+        blocks.edge_count = bsp.edges.count;
+        blocks.surface_count = bsp.surfaces.count;
+        blocks.reference_count = bsp.bsp2d_references.count;
+        workload.psp_collision_blocks.push_back(blocks);
+    }
+}
diff --git a/src/tag/parser/compile/psp_keyframes.cpp b/src/tag/parser/compile/psp_keyframes.cpp
new file mode 100644
index 00000000..ee00f267
--- /dev/null
+++ b/src/tag/parser/compile/psp_keyframes.cpp
@@ -0,0 +1,377 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+// PSP port: re-encode an uncompressed animation in Halo's own keyframe
+// format (the one model_animations.c decodes: animation_get_keyframe_rotation
+// and friends), choosing keyframes greedily so that the engine's
+// interpolation (nlerp for rotations, linear for translations and scales)
+// stays within a tolerance of the original frames. Frame 0 is the default;
+// the last frame is always a keyframe; a node whose every frame is within
+// tolerance of frame 0 gets no keyframes at all.
+//
+// Compressed layout (offsets from the header's start; little-endian):
+//   header: 11 longs of offsets, then one unsigned long per node that has
+//           the rotation flag: (first keyframe index << 12) | keyframe count
+//   rotation keyframe frame indices (u16, all rotated nodes' concatenated)
+//   default rotations (6-byte quaternion per node, every node)
+//   rotation keyframes (6-byte quaternions, concatenated)
+//   translation node headers (u32 per node with the translation flag)
+//   translation keyframe frame indices (u16)
+//   default translations (3 floats per node, every node)
+//   translation keyframes (3 floats each)
+//   scale node headers, scale keyframe frame indices, default scales, scale keyframes
+
+#include <invader/tag/parser/parser.hpp>
+#include <invader/build/build_workload.hpp>
+#include <cmath>
+#include <cstring>
+#include <vector>
+
+namespace Invader::Parser {
+    bool read_bit_from_bitfield(std::size_t offset, std::uint32_t *fields) noexcept;
+
+    namespace {
+        struct Quat { float i, j, k, w; };
+
+        constexpr float COMPONENT_MAXIMUM = 32767.0f;
+
+        Quat decode_8byte(const std::int16_t *v) {
+            return Quat { v[0] / COMPONENT_MAXIMUM, v[1] / COMPONENT_MAXIMUM, v[2] / COMPONENT_MAXIMUM, v[3] / COMPONENT_MAXIMUM };
+        }
+
+        // quaternion_compress_6byte / quaternion_decompress_6byte, as the engine has them
+        void encode_6byte(const Quat &q, std::uint16_t *words) {
+            long j = static_cast<long>(q.j * COMPONENT_MAXIMUM);
+            long k = static_cast<long>(q.k * COMPONENT_MAXIMUM);
+            long w = static_cast<long>(q.w * COMPONENT_MAXIMUM);
+            long i = static_cast<long>(q.i * COMPONENT_MAXIMUM);
+            words[0] = static_cast<std::uint16_t>((i & 0xFFF0) | (static_cast<std::uint16_t>(j) >> 12));
+            words[1] = static_cast<std::uint16_t>(((j & 0xFFF0) << 4) | ((static_cast<std::uint16_t>(k) >> 8) & 0x00FF));
+            words[2] = static_cast<std::uint16_t>(((k & 0x00F0) << 8) | (static_cast<std::uint16_t>(w) >> 4));
+        }
+
+        Quat decode_6byte(const std::uint16_t *words) {
+            std::uint16_t word0 = words[0], word1 = words[1], word2 = words[2];
+            std::int16_t i = static_cast<std::int16_t>((word0 >> 12) | (word0 & 0xFFF0));
+            std::int16_t j = static_cast<std::int16_t>(((word1 >> 4) & 0x0FF0) | (word0 & 0x000F) | (word0 << 12));
+            std::int16_t k = static_cast<std::int16_t>(((((word2 >> 4) & 0x0F00) | (word1 & 0x00F0)) >> 4) | (word1 << 8));
+            std::int16_t w = static_cast<std::int16_t>(((word2 >> 8) & 0x000F) | (word2 << 4));
+            return Quat { i / COMPONENT_MAXIMUM, j / COMPONENT_MAXIMUM, k / COMPONENT_MAXIMUM, w / COMPONENT_MAXIMUM };
+        }
+
+        Quat normalize(Quat q) {
+            float n = std::sqrt(q.i * q.i + q.j * q.j + q.k * q.k + q.w * q.w);
+            if(n > 0.0f) { q.i /= n; q.j /= n; q.k /= n; q.w /= n; }
+            return q;
+        }
+
+        // quaternions_interpolate_and_normalize: nlerp with the sign flip
+        Quat nlerp(const Quat &a, const Quat &b, float t) {
+            float v = 1.0f - t;
+            if(a.i * b.i + a.j * b.j + a.k * b.k + a.w * b.w < 0.0f) {
+                t = -t;
+            }
+            return normalize(Quat { a.i * v + b.i * t, a.j * v + b.j * t, a.k * v + b.k * t, a.w * v + b.w * t });
+        }
+
+        // the angle between two rotations, in degrees
+        double angle_between(const Quat &a0, const Quat &b0) {
+            Quat a = normalize(a0), b = normalize(b0);
+            double dot = std::fabs(static_cast<double>(a.i) * b.i + static_cast<double>(a.j) * b.j + static_cast<double>(a.k) * b.k + static_cast<double>(a.w) * b.w);
+            if(dot > 1.0) dot = 1.0;
+            return 2.0 * std::acos(dot) * 180.0 / 3.14159265358979323846;
+        }
+
+        // the value the engine would produce for frame f between keyframes at
+        // frames ka and kb holding (quantized) qa and qb
+        Quat engine_rotation(const Quat &qa, const Quat &qb, int ka, int kb, int f) {
+            float fraction = static_cast<float>(f - ka) / static_cast<float>(kb - ka);
+            return nlerp(qa, qb, fraction);
+        }
+
+        struct NodeKeys {
+            std::vector<std::uint16_t> frames; // keyframe frame indices (> 0, last = frame_count - 1); empty: constant
+        };
+
+        // greedy: from anchor a, extend b while every frame strictly between
+        // is within tolerance of the engine's interpolation between the two
+        // (quantized) keyframes
+        template <typename Value, typename Interp, typename Err>
+        NodeKeys choose_keys(const std::vector<Value> &frames, Interp interp, Err err, double tol) {
+            NodeKeys keys;
+            int F = static_cast<int>(frames.size());
+            // constant within tolerance of frame 0: no keyframes
+            bool constant = true;
+            for(int f = 1; f < F; f++) {
+                if(err(frames[0], frames[f]) > tol) { constant = false; break; }
+            }
+            if(constant) {
+                return keys;
+            }
+            int a = 0;
+            while(a < F - 1) {
+                int best = a + 1;
+                for(int b = a + 2; b < F; b++) {
+                    bool ok = true;
+                    for(int f = a + 1; f < b && ok; f++) {
+                        ok = err(interp(frames[a], frames[b], a, b, f), frames[f]) <= tol;
+                    }
+                    if(!ok) break;
+                    best = b;
+                }
+                keys.frames.push_back(static_cast<std::uint16_t>(best));
+                a = best;
+            }
+            if(keys.frames.empty() || keys.frames.back() != F - 1) {
+                keys.frames.push_back(static_cast<std::uint16_t>(F - 1));
+            }
+            return keys;
+        }
+
+        void append(std::vector<std::byte> &out, const void *data, std::size_t size) {
+            const auto *b = reinterpret_cast<const std::byte *>(data);
+            out.insert(out.end(), b, b + size);
+        }
+        void pad4(std::vector<std::byte> &out) {
+            while(out.size() % 4) out.push_back(std::byte());
+        }
+    }
+
+    // Returns true and replaces frame_data/default_data/flags when the
+    // animation was re-encoded. rotation_tolerance in degrees, translation
+    // tolerance in world units (also used for scale, as a fraction).
+    bool psp_keyframe_compress(ModelAnimationsAnimation &animation, double rotation_tolerance, double translation_tolerance, std::size_t &bytes_before, std::size_t &bytes_after) {
+        const std::size_t frame_count = animation.frame_count;
+        const std::size_t node_count = animation.node_count;
+        bytes_before = animation.frame_data.size() + animation.default_data.size();
+        bytes_after = bytes_before;
+        if(frame_count < 6 || node_count == 0 || node_count > 64 || animation.frame_data.empty()) {
+            return false;
+        }
+        if(animation.type == HEK::AnimationType::ANIMATION_TYPE_OVERLAY) {
+            return false; // overlay frames are not a time sequence (aiming screens are grids)
+        }
+        if(animation.flags & HEK::ModelAnimationsAnimationFlagsFlag::MODEL_ANIMATIONS_ANIMATION_FLAGS_FLAG_COMPRESSED_DATA) {
+            return false;
+        }
+
+        // Per node: the full sequence of values, frame 0 first. Unflagged
+        // components come from the default data (one value for all frames).
+        std::vector<bool> rot_flag(node_count), trn_flag(node_count), scl_flag(node_count);
+        std::size_t frame_size = 0;
+        for(std::size_t n = 0; n < node_count; n++) {
+            rot_flag[n] = read_bit_from_bitfield(n, animation.node_rotation_flag_data);
+            trn_flag[n] = read_bit_from_bitfield(n, animation.node_transform_flag_data);
+            scl_flag[n] = read_bit_from_bitfield(n, animation.node_scale_flag_data);
+            frame_size += (rot_flag[n] ? 8 : 0) + (trn_flag[n] ? 12 : 0) + (scl_flag[n] ? 4 : 0);
+        }
+        if(animation.frame_data.size() < frame_size * frame_count) {
+            return false;
+        }
+        std::vector<std::vector<Quat>> rotations(node_count);
+        std::vector<std::vector<std::array<float, 3>>> translations(node_count);
+        std::vector<std::vector<float>> scales(node_count);
+        const std::byte *frame_bytes = animation.frame_data.data();
+        for(std::size_t f = 0; f < frame_count; f++) {
+            const std::byte *p = frame_bytes + f * frame_size;
+            for(std::size_t n = 0; n < node_count; n++) {
+                if(rot_flag[n]) {
+                    std::int16_t v[4];
+                    std::memcpy(v, p, 8);
+                    rotations[n].push_back(decode_8byte(v));
+                    p += 8;
+                }
+                if(trn_flag[n]) {
+                    std::array<float, 3> t;
+                    std::memcpy(t.data(), p, 12);
+                    translations[n].push_back(t);
+                    p += 12;
+                }
+                if(scl_flag[n]) {
+                    float s;
+                    std::memcpy(&s, p, 4);
+                    scales[n].push_back(s);
+                    p += 4;
+                }
+            }
+        }
+        // defaults for the unflagged components (interleaved per node)
+        std::vector<Quat> default_rotation(node_count, Quat { 0, 0, 0, 1 });
+        std::vector<std::array<float, 3>> default_translation(node_count, std::array<float, 3> { 0, 0, 0 });
+        std::vector<float> default_scale(node_count, 1.0f);
+        {
+            const std::byte *p = animation.default_data.data();
+            const std::byte *end = p + animation.default_data.size();
+            for(std::size_t n = 0; n < node_count; n++) {
+                if(!rot_flag[n]) {
+                    if(p + 8 > end) return false;
+                    std::int16_t v[4];
+                    std::memcpy(v, p, 8);
+                    default_rotation[n] = decode_8byte(v);
+                    p += 8;
+                }
+                if(!trn_flag[n]) {
+                    if(p + 12 > end) return false;
+                    std::memcpy(default_translation[n].data(), p, 12);
+                    p += 12;
+                }
+                if(!scl_flag[n]) {
+                    if(p + 4 > end) return false;
+                    std::memcpy(&default_scale[n], p, 4);
+                    p += 4;
+                }
+            }
+        }
+        for(std::size_t n = 0; n < node_count; n++) {
+            if(rot_flag[n]) default_rotation[n] = rotations[n][0];
+            if(trn_flag[n]) default_translation[n] = translations[n][0];
+            if(scl_flag[n]) default_scale[n] = scales[n][0];
+        }
+
+        // Choose keyframes. Rotations are compared as the engine will see
+        // them: both keyframes quantized to 6 bytes, nlerp between.
+        auto rot_interp = [](const Quat &a, const Quat &b, int ka, int kb, int f) {
+            std::uint16_t wa[3], wb[3];
+            encode_6byte(a, wa); encode_6byte(b, wb);
+            return engine_rotation(decode_6byte(wa), decode_6byte(wb), ka, kb, f);
+        };
+        auto rot_err = [](const Quat &a, const Quat &b) { return angle_between(a, b); };
+        auto trn_interp = [](const std::array<float, 3> &a, const std::array<float, 3> &b, int ka, int kb, int f) {
+            float t = static_cast<float>(f - ka) / static_cast<float>(kb - ka);
+            return std::array<float, 3> { a[0] * (1 - t) + b[0] * t, a[1] * (1 - t) + b[1] * t, a[2] * (1 - t) + b[2] * t };
+        };
+        auto trn_err = [](const std::array<float, 3> &a, const std::array<float, 3> &b) {
+            double e = 0;
+            for(int i = 0; i < 3; i++) e = std::max(e, std::fabs(static_cast<double>(a[i]) - b[i]));
+            return e;
+        };
+        auto scl_interp = [](float a, float b, int ka, int kb, int f) {
+            float t = static_cast<float>(f - ka) / static_cast<float>(kb - ka);
+            return a * (1 - t) + b * t;
+        };
+        auto scl_err = [](float a, float b) { return std::fabs(static_cast<double>(a) - b); };
+
+        std::vector<NodeKeys> rot_keys(node_count), trn_keys(node_count), scl_keys(node_count);
+        for(std::size_t n = 0; n < node_count; n++) {
+            if(rot_flag[n]) rot_keys[n] = choose_keys(rotations[n], rot_interp, rot_err, rotation_tolerance);
+            if(trn_flag[n]) trn_keys[n] = choose_keys(translations[n], trn_interp, trn_err, translation_tolerance);
+            if(scl_flag[n]) scl_keys[n] = choose_keys(scales[n], scl_interp, scl_err, translation_tolerance);
+        }
+
+        // Assemble. Header first (its size depends on the rotated node count).
+        std::size_t rotated = 0, translated = 0, scaled = 0;
+        for(std::size_t n = 0; n < node_count; n++) { rotated += rot_flag[n]; translated += trn_flag[n]; scaled += scl_flag[n]; }
+        std::vector<std::byte> out;
+        std::uint32_t header[11] = {};
+        out.resize(11 * 4 + rotated * 4);
+        // rotation node headers
+        {
+            std::uint32_t *rot_headers = reinterpret_cast<std::uint32_t *>(out.data() + 44);
+            std::uint32_t first = 0, r = 0;
+            for(std::size_t n = 0; n < node_count; n++) {
+                if(!rot_flag[n]) continue;
+                std::uint32_t count = static_cast<std::uint32_t>(rot_keys[n].frames.size());
+                if(count >= 4096) return false;
+                rot_headers[r++] = (first << 12) | count;
+                first += count;
+            }
+        }
+        // rotation keyframe frame indices
+        header[0] = static_cast<std::uint32_t>(out.size());
+        for(std::size_t n = 0; n < node_count; n++) {
+            if(!rot_flag[n]) continue;
+            append(out, rot_keys[n].frames.data(), rot_keys[n].frames.size() * 2);
+        }
+        // default rotations (every node)
+        header[1] = static_cast<std::uint32_t>(out.size());
+        for(std::size_t n = 0; n < node_count; n++) {
+            std::uint16_t w[3];
+            encode_6byte(default_rotation[n], w);
+            append(out, w, 6);
+        }
+        // rotation keyframes
+        header[2] = static_cast<std::uint32_t>(out.size());
+        for(std::size_t n = 0; n < node_count; n++) {
+            if(!rot_flag[n]) continue;
+            for(auto f : rot_keys[n].frames) {
+                std::uint16_t w[3];
+                encode_6byte(rotations[n][f], w);
+                append(out, w, 6);
+            }
+        }
+        // translation node headers
+        pad4(out);
+        header[3] = static_cast<std::uint32_t>(out.size());
+        {
+            std::uint32_t first = 0;
+            for(std::size_t n = 0; n < node_count; n++) {
+                if(!trn_flag[n]) continue;
+                std::uint32_t count = static_cast<std::uint32_t>(trn_keys[n].frames.size());
+                if(count >= 4096) return false;
+                std::uint32_t h = (first << 12) | count;
+                append(out, &h, 4);
+                first += count;
+            }
+        }
+        header[4] = static_cast<std::uint32_t>(out.size());
+        for(std::size_t n = 0; n < node_count; n++) {
+            if(!trn_flag[n]) continue;
+            append(out, trn_keys[n].frames.data(), trn_keys[n].frames.size() * 2);
+        }
+        pad4(out);
+        header[5] = static_cast<std::uint32_t>(out.size());
+        for(std::size_t n = 0; n < node_count; n++) {
+            append(out, default_translation[n].data(), 12);
+        }
+        header[6] = static_cast<std::uint32_t>(out.size());
+        for(std::size_t n = 0; n < node_count; n++) {
+            if(!trn_flag[n]) continue;
+            for(auto f : trn_keys[n].frames) {
+                append(out, translations[n][f].data(), 12);
+            }
+        }
+        // scales
+        pad4(out);
+        header[7] = static_cast<std::uint32_t>(out.size());
+        {
+            std::uint32_t first = 0;
+            for(std::size_t n = 0; n < node_count; n++) {
+                if(!scl_flag[n]) continue;
+                std::uint32_t count = static_cast<std::uint32_t>(scl_keys[n].frames.size());
+                if(count >= 4096) return false;
+                std::uint32_t h = (first << 12) | count;
+                append(out, &h, 4);
+                first += count;
+            }
+        }
+        header[8] = static_cast<std::uint32_t>(out.size());
+        for(std::size_t n = 0; n < node_count; n++) {
+            if(!scl_flag[n]) continue;
+            append(out, scl_keys[n].frames.data(), scl_keys[n].frames.size() * 2);
+        }
+        pad4(out);
+        header[9] = static_cast<std::uint32_t>(out.size());
+        for(std::size_t n = 0; n < node_count; n++) {
+            append(out, &default_scale[n], 4);
+        }
+        header[10] = static_cast<std::uint32_t>(out.size());
+        for(std::size_t n = 0; n < node_count; n++) {
+            if(!scl_flag[n]) continue;
+            for(auto f : scl_keys[n].frames) {
+                append(out, &scales[n][f], 4);
+            }
+        }
+        pad4(out);
+        std::memcpy(out.data(), header, sizeof(header));
+
+        if(out.size() >= bytes_before) {
+            return false; // no gain: keep it as it was
+        }
+        (void)scaled; (void)translated;
+        animation.frame_data = out;
+        animation.default_data.clear();
+        animation.flags = static_cast<HEK::ModelAnimationsAnimationFlags>(animation.flags | HEK::ModelAnimationsAnimationFlagsFlag::MODEL_ANIMATIONS_ANIMATION_FLAGS_FLAG_COMPRESSED_DATA);
+        animation.offset_to_compressed_data = 0;
+        bytes_after = out.size();
+        return true;
+    }
+}
diff --git a/src/tag/parser/compile/scenario/pre_compile.cpp b/src/tag/parser/compile/scenario/pre_compile.cpp
index 47685660..afc82405 100644
--- a/src/tag/parser/compile/scenario/pre_compile.cpp
+++ b/src/tag/parser/compile/scenario/pre_compile.cpp
@@ -135,7 +135,57 @@ namespace Invader::Parser {
         RIAT::CompilerScriptResult result;
         try {
             for(auto &source : source_files) {
-                instance.read_script_data(reinterpret_cast<const std::uint8_t *>(source.source.data()), source.source.size(), (std::string(source.name.string) + ".hsc").c_str());
+                // PSP port: Bungie's script sources are Windows-1252, and a few
+                // campaign scenarios (c10, c40, d20) have an ellipsis or a curly
+                // apostrophe inside debug print strings, which RIAT refuses as
+                // invalid UTF-8. A source that isn't valid UTF-8 gets those bytes
+                // as plain ASCII ("..." and ' ; any other one as ?).
+                const auto *bytes = reinterpret_cast<const std::uint8_t *>(source.source.data());
+                std::size_t size = source.source.size();
+                bool valid_utf8 = true;
+                for(std::size_t i = 0; i < size && valid_utf8;) {
+                    std::uint8_t c = bytes[i];
+                    std::size_t extra = c < 0x80 ? 0 : (c & 0xE0) == 0xC0 ? 1 : (c & 0xF0) == 0xE0 ? 2 : (c & 0xF8) == 0xF0 ? 3 : 4;
+                    if(extra == 4 || i + extra >= size + (extra ? 0 : 1)) {
+                        valid_utf8 = extra == 0;
+                        break;
+                    }
+                    for(std::size_t k = 1; k <= extra; k++) {
