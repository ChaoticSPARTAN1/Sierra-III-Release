+                        std::uint16_t p16 = flag16(plane, "reference plane"), n16 = flag16(node, "reference bsp2d node");
+                        std::memcpy(packed.data() + i * 4, &p16, 2); std::memcpy(packed.data() + i * 4 + 2, &n16, 2);
