+    void BuildWorkload::slim_psp_blocks() {
+        static_assert(sizeof(Parser::SoundPermutation::struct_little) == PSP_PERMUTATION_SIZE, "the Xbox permutation is 124 bytes");
+        static_assert(sizeof(Parser::SoundPitchRange::struct_little) == 72, "the Xbox pitch range is 72 bytes");
+        static_assert(sizeof(Parser::ScenarioSquad::struct_little) == 232, "the Xbox squad is 232 bytes");
+        static_assert(sizeof(Parser::ScenarioFiringPosition::struct_little) == 24, "the Xbox firing position is 24 bytes");
+        std::vector<std::size_t> permutations, pitch_ranges, squads, firing_positions;
+        for(auto &t : this->tags) {
+            if(!t.base_struct.has_value()) {
+                continue;
+            }
+            auto &base = this->structs[*t.base_struct];
+            if(t.tag_fourcc == TagFourCC::TAG_FOURCC_SOUND) {
+                auto &sound = *reinterpret_cast<Parser::Sound::struct_little *>(base.data.data());
+                if(sound.pitch_ranges.count.read() == 0) {
+                    continue;
+                }
+                auto pitch_range_index = base.resolve_pointer(&sound.pitch_ranges.pointer);
+                psp_slim_add(pitch_ranges, pitch_range_index);
+                auto &pitch_range_struct = this->structs[*pitch_range_index];
+                auto *ranges = reinterpret_cast<Parser::SoundPitchRange::struct_little *>(pitch_range_struct.data.data());
+                for(std::size_t pr = 0; pr < sound.pitch_ranges.count.read(); pr++) {
+                    if(ranges[pr].permutations.count.read() > 0) {
+                        psp_slim_add(permutations, pitch_range_struct.resolve_pointer(&ranges[pr].permutations.pointer));
+                    }
+                }
+            }
+            else if(t.tag_fourcc == TagFourCC::TAG_FOURCC_SCENARIO) {
+                auto &scenario = *reinterpret_cast<Parser::Scenario::struct_little *>(base.data.data());
+                if(scenario.encounters.count.read() == 0) {
+                    continue;
+                }
+                auto &encounter_struct = this->structs[*base.resolve_pointer(&scenario.encounters.pointer)];
+                auto *encounters = reinterpret_cast<Parser::ScenarioEncounter::struct_little *>(encounter_struct.data.data());
+                for(std::size_t e = 0; e < scenario.encounters.count.read(); e++) {
+                    if(encounters[e].squads.count.read() > 0) {
+                        psp_slim_add(squads, encounter_struct.resolve_pointer(&encounters[e].squads.pointer));
+                    }
+                    if(encounters[e].firing_positions.count.read() > 0) {
+                        psp_slim_add(firing_positions, encounter_struct.resolve_pointer(&encounters[e].firing_positions.pointer));
+                    }
+                }
+            }
+        }
+        // children before parents: a permutation array's place is read from its pitch range
+        this->slim_psp_block("sound permutations", PSP_PERMUTATION_SIZE, {{PSP_PERMUTATION_KEEP_FROM, PSP_PERMUTATION_KEEP_TO}}, permutations);
+        this->slim_psp_block("sound pitch ranges", 72, {{32, 72}}, pitch_ranges);
+        this->slim_psp_block("AI squads", 232, {{0, 48}, {76, 148}, {196, 220}}, squads);
+        this->slim_psp_block("AI firing positions", 24, {{0, 16}, {20, 24}}, firing_positions);
+    }
