+    }
+
+    // PSP port (-Z): tag blocks whose elements carry bytes the port never
+    // reads (names it only prints, padding, subtitles) are written without
+    // them, just before layout, like the collision packing. Each rule names a
+    // block, its Xbox element size and the byte ranges kept, in order; the
+    // port's own structs have the slim layout (psp_fixups.py FIXES_108), and
+    // the geometry pack's header word 10 says which rules a map was built
+    // with (one bit each; the port reads older maps as they are).
+    //   bit 0  sound permutations: no name (32), no subtitle data (20): 124 -> 72
+    //   bit 1  sound pitch ranges: no name (32): 72 -> 40
+    //   bit 2  AI squads: no name (32), no trailing unused block (12): 232 -> 188
+    //   bit 3  AI firing positions: no padding (4, before the surface index): 24 -> 20
+    // generate_bitmap_sound_data finds the samples' file offset at the slim
+    // permutation's place.
+    static constexpr std::size_t PSP_PERMUTATION_SIZE = 124, PSP_PERMUTATION_KEEP_FROM = 32, PSP_PERMUTATION_KEEP_TO = 104;
+    static constexpr std::size_t PSP_SLIM_PERMUTATION_SIZE = PSP_PERMUTATION_KEEP_TO - PSP_PERMUTATION_KEEP_FROM;
+
+    struct PSPSlimRule {
+        const char *what;
+        std::uint32_t bit;
+        std::size_t element_size;
+        std::vector<std::pair<std::size_t, std::size_t>> kept; // [from, to) of the Xbox element, in order
+    };
+
+    // the arrays of every block a rule covers, each once (deduplicated structs are shared)
+    static void psp_slim_add(std::vector<std::size_t> &arrays, std::optional<std::size_t> index) {
+        if(index.has_value() && std::find(arrays.begin(), arrays.end(), *index) == arrays.end()) {
+            arrays.push_back(*index);
+        }
+    }
+
+    std::size_t BuildWorkload::slim_psp_block(const char *what, std::size_t element_size, const std::vector<std::pair<std::size_t, std::size_t>> &kept, const std::vector<std::size_t> &arrays) {
+        std::size_t slim_size = 0;
+        for(auto &k : kept) {
+            slim_size += k.second - k.first;
+        }
+        // where an Xbox offset goes, or SIZE_MAX if it is left out
+        auto place = [&kept](std::size_t within) -> std::size_t {
+            std::size_t at = 0;
+            for(auto &k : kept) {
+                if(within >= k.first && within < k.second) {
+                    return at + within - k.first;
+                }
+                at += k.second - k.first;
+            }
+            return SIZE_MAX;
+        };
+        std::size_t saved = 0, elements = 0;
+        for(auto index : arrays) {
+            auto &array = this->structs[index];
+            std::size_t count = array.data.size() / element_size;
+            if(count * element_size != array.data.size()) {
+                REPORT_ERROR_PRINTF(*this, ERROR_TYPE_FATAL_ERROR, std::nullopt, "PSP slim %s: an array of %zu bytes isn't whole elements of %zu", what, array.data.size(), element_size);
+                throw InvalidTagDataException();
+            }
+            std::vector<std::byte> slim(count * slim_size);
+            for(std::size_t i = 0; i < count; i++) {
+                std::size_t at = i * slim_size;
+                for(auto &k : kept) {
+                    std::memcpy(slim.data() + at, array.data.data() + i * element_size + k.first, k.second - k.first);
+                    at += k.second - k.first;
+                }
+            }
+            std::vector<BuildWorkloadStructPointer> pointers;
+            for(auto p : array.pointers) {
+                std::size_t element = p.offset / element_size, moved = place(p.offset % element_size);
+                if(moved == SIZE_MAX) {
+                    // what pointed from a left-out part (a permutation's subtitle data) stays in the tag data, unreferenced
+                    REPORT_ERROR_PRINTF(*this, ERROR_TYPE_WARNING, std::nullopt, "PSP slim %s: data pointed to from a left-out part stays unreferenced", what);
+                    continue;
+                }
+                p.offset = element * slim_size + moved;
+                pointers.push_back(p);
+            }
+            for(auto &d : array.dependencies) {
+                std::size_t element = d.offset / element_size, moved = place(d.offset % element_size);
+                if(moved == SIZE_MAX) {
+                    REPORT_ERROR_PRINTF(*this, ERROR_TYPE_FATAL_ERROR, std::nullopt, "PSP slim %s: a tag reference in a left-out part", what);
+                    throw InvalidTagDataException();
+                }
+                d.offset = element * slim_size + moved;
+            }
+            saved += array.data.size() - slim.size();
+            elements += count;
+            array.data = std::move(slim);
+            array.pointers = std::move(pointers);
+        }
+        if(this->parameters->verbosity > BuildParameters::BuildVerbosity::BUILD_VERBOSITY_QUIET) {
+            oprintf("PSP slim %s: %zu in %zu arrays, %zu -> %zu bytes each, %.02f MiB saved\n", what, elements, arrays.size(), element_size, slim_size, BYTES_TO_MiB(saved));
+        }
+        this->psp_slim_bytes += saved;
+        return saved;
+    }
