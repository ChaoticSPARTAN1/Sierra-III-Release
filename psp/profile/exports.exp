# halo_profile.prx's exports (build 46): the module's own entry points, and
# halo_profile_phase as a system call the game (user mode) can make
# (attribute 0x4001: exported to user mode through the syscall table; the
# pattern mcidclan's mecore kernel/exports.exp uses for kcall)
PSP_BEGIN_EXPORTS

PSP_EXPORT_START(syslib, 0, 0x8000)
PSP_EXPORT_FUNC_HASH(module_start)
PSP_EXPORT_FUNC_HASH(module_stop)
PSP_EXPORT_VAR_HASH(module_info)
PSP_EXPORT_END

PSP_EXPORT_START(halo_profile, 0, 0x4001)
PSP_EXPORT_FUNC(halo_profile_phase)
# build 105: the read-only bus-priority probe
PSP_EXPORT_FUNC(halo_profile_bus_probe)
PSP_EXPORT_END

PSP_END_EXPORTS
